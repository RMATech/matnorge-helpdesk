{
  "scripts": {
    "adminLoginPage:sass": "sass customizationUI/scss/mainStaffLogin.scss css/customStaffLoginPage.css --watch",
    "clientPanel:sass": "sass customizationUI/scss/mainClientPanel.scss css/customClientPanel.css --watch",
    "adminPanel:sass": "sass customizationUI/scss/mainStaffPanel.scss css/customStaffPanel.css --watch",
    "compile:sass": "concurrently --kill-others \"yarn run adminLoginPage:sass\" \"yarn run adminPanel:sass\" \"yarn run clientPanel:sass\""
  },
  "dependencies": {
    "concurrently": "^7.6.0",
    "sass": "^1.85.1"
  }
}
